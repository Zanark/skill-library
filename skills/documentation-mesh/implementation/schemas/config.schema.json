{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/documentation-mesh/config.schema.json",
  "title": "Documentation Mesh configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceRoots",
    "includeGlobs",
    "excludeGlobs",
    "outputDirectory",
    "cachePath",
    "runtimeVersion",
    "pluginVersion"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceRoots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "includeGlobs": { "type": "array", "items": { "type": "string" } },
    "excludeGlobs": { "type": "array", "items": { "type": "string" } },
    "generatedDocumentGlobs": { "type": "array", "items": { "type": "string" } },
    "archivedDocumentGlobs": { "type": "array", "items": { "type": "string" } },
    "outputDirectory": { "type": "string", "minLength": 1 },
    "cachePath": { "type": "string", "minLength": 1 },
    "gitHistoryEnabled": { "type": "boolean" },
    "sessionProvenanceEnabled": { "type": "boolean" },
    "sessionStateRoot": { "type": "string" },
    "historyWindowDays": { "type": "integer", "minimum": 1 },
    "freshDays": { "type": "integer", "minimum": 0 },
    "agingDays": { "type": "integer", "minimum": 0 },
    "staleDays": { "type": "integer", "minimum": 0 },
    "maximumOptionalEntityNodes": { "type": "integer", "minimum": 0 },
    "defaultEvidenceLevel": {
      "enum": ["strong", "inferred", "incidental"]
    },
    "defaultDetailLevel": {
      "enum": ["documents", "sections", "entities", "full"]
    },
    "browserExecutablePath": { "type": "string" },
    "workspaceLocation": { "type": "string" },
    "runtimeVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "pluginVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "allowWorkspaceInitialization": { "type": "boolean" }
  },
  "additionalProperties": false
}
